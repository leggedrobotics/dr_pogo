# DRO (dr_pogo, leggedrobotics ras3 branch) as an online ROS 2 Jazzy node on
# NVIDIA Jetson Thor (pc7). Sister service to CFEAR in FogNav-radar-splatting.
#
# Build from the repository root (the compose `dro` service does this):
#   docker build -f docker/Dockerfile.jetson -t rslethz/fognav:dro .
#
# Base: jetfast:thor-dev is built locally on pc7 (no registry) and already
# carries ROS 2 Jazzy, PyTorch 2.12+cu130 for sm_110, torchvision, OpenCV,
# cv_bridge, message_filters, Ceres, yaml-cpp and CycloneDDS -- all inside the
# same /opt/venv python, which is what makes `import torch` and `import rclpy`
# coexist. Do not swap it for an l4t-pytorch image without re-checking that.
FROM jetfast:thor-dev

ENV DEBIAN_FRONTEND=noninteractive

# dro.py imports sklearn at module level (pairwise_distances); scikit-image is
# only needed by raplace_node. pc7's pip defaults to a local devpi mirror that
# does not carry scikit-learn, hence the explicit index.
#
# empy/lark/catkin_pkg: the base image carries the ROS runtime in /opt/venv but
# not the interface-generation deps, and CMake resolves python to that venv
# (/root/.local/bin/python3.12), so rosidl_adapter died with "No module named
# em". Jazzy's rosidl needs empy 3.x -- 4.x removed the API it uses.
RUN /opt/venv/bin/python3 -m pip install --no-cache-dir \
        --index-url https://pypi.org/simple \
        scikit-learn scikit-image "empy==3.3.4" lark catkin_pkg

# Same RMW and tuned config as the robot side / CFEAR (bigger receive buffers
# for whole-rotation radar frames).
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
COPY docker/cyclonedds.xml /ws/config/cyclonedds.xml
ENV CYCLONEDDS_URI=file:///ws/config/cyclonedds.xml

WORKDIR /ws
COPY . src/dr_pogo
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --merge-install --packages-select dr_pogo \
        --cmake-args -DCMAKE_BUILD_TYPE=Release

RUN echo 'source /opt/ros/jazzy/setup.bash' >> /root/.bashrc && \
    echo 'source /ws/install/setup.bash' >> /root/.bashrc

# Rosbag recording from inside this container. b2w_rsl's `rservice-record`
# (utils/deploy_utils/functions.sh) does
#   docker compose exec dro tmux new-session ... record-bag <bag> <topics...>
# so both have to exist HERE. jetfast:thor-dev already carries tmux; record-bag
# comes from the b2w utils image, exactly as docker/navtech_radar/Dockerfile in
# b2w_rsl does it (that image is a few tens of kB of plain files, so it is
# architecture-agnostic and works on the Thor). `docker compose exec` skips the
# ENTRYPOINT, so ros2 reaches the recorder only through the shell tmux starts:
# a LOGIN shell, whose /root/.profile sources the /root/.bashrc lines above.
# Verified in this image (ros2 -> /opt/ros/jazzy/bin/ros2 in a tmux pane).
# Bags land in /bags -- bind-mounted to ~/bags by the compose service.
COPY --from=rslethz/b2w:deploy_utils /record-bag.sh /usr/local/bin/record-bag
RUN chmod +x /usr/local/bin/record-bag

# Chain through the base image's entrypoint rather than replacing it: it
# prepends /usr/lib/aarch64-linux-gnu to LD_LIBRARY_PATH so torch loads the
# system cuDNN (9.21.1, matching CUDA 13.0) instead of the pip
# nvidia-cudnn-cu13 wheel (9.20.0) also present in the venv. With a plain
# ROS-only entrypoint the pip copy loads first and the very first conv2d dies
# with CUDNN_STATUS_SUBLIBRARY_VERSION_MISMATCH.
COPY docker/ros_entrypoint.sh /ros_entrypoint_dro.sh
ENTRYPOINT ["/docker-entrypoint.sh", "/ros_entrypoint_dro.sh"]
CMD ["bash"]
